{#- JSON string with the escaping ai-rulez writes back: only the backslash and
    the quote, everything else literal UTF-8. Not `tojson`, which HTML-escapes
    `&`, `<` and `>` and splits emoji into surrogate pairs. The answers'
    validators already reject control characters. -#}
{%- macro j(value) -%}
"{{ value | replace('\\', '\\\\') | replace('"', '\\"') }}"
{%- endmacro -%}
{#- Written in the exact form `ai-rulez generate --plugin` leaves it (sorted keys,
    expanded arrays, the derived Pi fields), so a repo's committed file and a
    fresh render share one layout and `copier update` merges edits cleanly. The
    generator re-derives `files`, `pi` and the `pi-package` keyword from the
    skills on disk. -#}
{
  "author": {
    "name": {{ j(author_name) }},
    "url": {{ j(author_url) }}
  },
  "description": {{ j(description) }},
  "devDependencies": {
    "ai-rulez": "5.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "skills/{{ placeholder_skill }}/SKILL.md",
    "README.md"
  ],
  "keywords": [
{%- for keyword in (keywords_json + ["pi-package"]) | unique | list %}
    {{ j(keyword) }}{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "license": "{{ license }}",
  "name": "{{ repo_name }}",
  "pi": {
    "skills": [
      "./skills/{{ placeholder_skill }}"
    ],
    "prompts": []
  },
{%- if not publish_to_npm %}
  "private": true,
{%- endif %}
  "repository": {
    "type": "git",
    "url": "{{ repo_url }}"
  },
  "scripts": {
    "check": "node scripts/check-repo.mjs && ai-rulez generate --check --no-self-mcp --strict-config && ai-rulez verify --plugin && ai-rulez validate --strict",
    "generate": "ai-rulez generate --no-self-mcp --strict-config && ai-rulez generate --plugin"
  },
  "version": "0.0.0"
}
