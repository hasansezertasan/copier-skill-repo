{
  "name": "{{ repo_name }}",
  "version": "0.1.0",
  "description": {{ description | tojson }},
  "license": "{{ license }}",
  "author": {
    "name": {{ author_name | tojson }},
    "url": {{ author_url | tojson }}
  },
  "repository": {
    "type": "git",
    "url": "{{ repo_url }}"
  },
  "keywords": {{ keywords.split(',') | map('trim') | reject('equalto', '') | list | tojson }},
  "scripts": {
    "generate": "ai-rulez generate --no-self-mcp --strict-config && ai-rulez generate --plugin",
    "check": "ai-rulez generate --check --no-self-mcp --strict-config && ai-rulez verify --plugin && ai-rulez validate --strict"
  },
  "devDependencies": {
    "ai-rulez": "5.3.0"
  }
}
