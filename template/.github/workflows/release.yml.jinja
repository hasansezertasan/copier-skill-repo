name: Release

on:
  push:
    branches:
      - main

permissions: {}

# Preserve a running tag or release operation; a queued run can still be
# superseded by a newer one.
concurrency:
  group: release
  cancel-in-progress: false

jobs:
  check:
    permissions:
      contents: read
    uses: ./.github/workflows/check.yml

  guard:
    needs: check
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .node-version
      - run: node scripts/release-guard.mjs {{ '--publish' if publish_to_npm else '--private' }}

  release-please:
    needs: guard
    runs-on: ubuntu-latest
    permissions:
      contents: write
      issues: write # release-please manages PR labels through the Issues API
      pull-requests: write
    outputs:
      release_created: ${{ '{{' }} steps.release.outputs.release_created {{ '}}' }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .node-version
      # release-please can otherwise release an older pending, failed merge on a
      # later green push. Require a single pending release merged as this commit.
      - id: release-merge
        env:
          GH_TOKEN: ${{ '{{' }} github.token {{ '}}' }}
          REPO: ${{ '{{' }} github.repository {{ '}}' }}
          SHA: ${{ '{{' }} github.sha {{ '}}' }}
        run: |
          gh api --paginate --slurp "repos/$REPO/pulls?state=closed&base=main&per_page=100" > "$RUNNER_TEMP/closed-prs.json"
          node scripts/release-merge.mjs --pulls "$RUNNER_TEMP/closed-prs.json" --sha "$SHA" >> "$GITHUB_OUTPUT"
      # Runs with the implicit GITHUB_TOKEN on purpose: a PAT or App token would
      # be a standing credential with write access to main. The cost is that
      # events created with GITHUB_TOKEN start no workflow runs, so the release
      # PR reports no required checks until someone closes and reopens it
      # (check.yml runs on `reopened` and can be dispatched on the release
      # branch). The repository setting "Allow GitHub Actions to create and
      # approve pull requests" must also be on.
      - id: release
        uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7 # v5.0.0
        with:
          config-file: release-please-config.json
          manifest-file: .release-please-manifest.json
          skip-github-release: ${{ '{{' }} steps.release-merge.outputs.is-release-merge != 'true' {{ '}}' }}
      # release-please bumps package.json and the plugin manifests, but cannot
      # update the hash ledger (.ai-rulez-generated.json) that `npm run check`
      # verifies, so the release PR would fail its own check. Regenerate the
      # output on the release branch and push it. Pushes made with GITHUB_TOKEN
      # start no workflow runs, so there is no loop; see the note above for how
      # to get a check on the final head.
      - name: Check out the release PR branch
        if: ${{ '{{' }} steps.release.outputs.prs_created == 'true' {{ '}}' }}
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ '{{' }} fromJSON(steps.release.outputs.pr || '{}').headBranchName {{ '}}' }}
      - name: Regenerate, validate and commit the release output
        if: ${{ '{{' }} steps.release.outputs.prs_created == 'true' {{ '}}' }}
        env:
          PR: ${{ '{{' }} steps.release.outputs.pr {{ '}}' }}
        run: |
          BRANCH=$(jq -er .headBranchName <<< "$PR")
          npm ci
          npm run generate
          # Only generated output, and only what exists in this repo.
          for path in AGENTS.md skills .claude-plugin .codex-plugin .agents .ai-rulez-generated.json .ai-rulez/.generated-manifest.json; do
            if [ -e "$path" ]; then git add -A -- "$path"; fi
          done
          if git diff --cached --quiet; then
            echo "Generated output already matches the release version."
            npm run check
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git commit -m "chore: regenerate plugin output for the release"
          # Check the committed tree: strict validation reports plugin-version
          # drift (AR961) while generated output differs from HEAD. A failing
          # check stops the job before anything is pushed.
          npm run check
          git push origin "HEAD:$BRANCH"
{%- if publish_to_npm %}

  publish:
    needs: release-please
    if: ${{ '{{' }} needs.release-please.outputs.release_created {{ '}}' }}
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .node-version
          registry-url: https://registry.npmjs.org
      # Trusted publishing needs npm 11.5.1 or newer.
      - run: npm install --global npm@11.5.1
      - run: npm ci
      - run: npm publish --provenance --access public
{%- endif %}
