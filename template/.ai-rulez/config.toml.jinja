{#- TOML basic string. Not `tojson`: that emits surrogate-pair escapes for
    characters outside the BMP (emoji), which TOML rejects. -#}
{%- macro q(value) -%}
"{{ value | replace('\\', '\\\\') | replace('"', '\\"') | replace('\n', '\\n') | replace('\r', '\\r') | replace('\t', '\\t') }}"
{%- endmacro -%}
# ai-rulez source of truth for this repo's skills.
# Edit files under .ai-rulez/, then run `npm run generate`.
# Docs: https://github.com/Goldziher/ai-rulez
version = "5.0"
name = {{ q(display_name) }}
# Generated files are committed; .gitignore is not touched.
gitignore = false

# The Antigravity adapter (plugin.json) must sit at the repository root, because
# Antigravity installs straight from the Git URL. ai-rulez warns (AR9T0) that
# Codex may load a root plugin.json too; the adapter carries only the plugin name
# and description, and scripts/check-repo.mjs keeps it equal to the Claude manifest.
# Tested with codex-cli 0.162.1: a root plugin.json declaring the Antigravity
# $schema is ignored and Codex falls back to .codex-plugin/plugin.json, but one
# declaring the portable agent-plugins.org $schema is adopted as Codex's manifest.
# Keep the Antigravity $schema, and re-test when Codex changes. AR9T0 also
# flags .mcp.json, hooks/ and the other host-loaded paths at the root, so
# scripts/check-repo.mjs rejects those itself; keep its list in step with the rule.
# Root skills/ is generated from .ai-rulez/skills/, so from ai-rulez 5.5 every skill
# there is reported as a duplicate of its source (AR701, AR703). Drop findings for
# the generated copies only; duplicates among the sources are still reported.
[lint]
ignore_paths = ["skills/**"]

[lint.severity]
AR9T0 = "off"

# Plugin and marketplace manifests, the Codex catalog and root skills/ are
# generated by `ai-rulez generate --plugin` and checked by `verify --plugin`.
# The version is read from package.json, the one file release-please bumps;
# it is the sole version source, so do not add a literal `version` here.
[plugin]
name = "{{ repo_name }}"
version_from = "package.json"
description = {{ q(description) }}
repository = "{{ repo_url }}"
keywords = [{% for keyword in keywords_json %}{{ q(keyword) }}{% if not loop.last %}, {% endif %}{% endfor %}]
runtimes = ["claude", "codex", "pi"]
category = "Productivity"
content_root = ".ai-rulez"
provenance_headers = false

[plugin.author]
name = {{ q(author_name) }}
url = {{ q(author_url) }}

[plugin.interface]
display_name = {{ q(display_name) }}
short_description = {{ q(description) }}
category = "Development"
capabilities = ["Read", "Write"]
default_prompt = ["Use the {{ placeholder_skill }} skill."]
long_description = {{ q(description) }}
developer_name = {{ q(author_name) }}

# Single-plugin catalogs point at the repository root ("./").
[plugin.codex]
marketplace = true

# Pi reads the root skills/ tree. ai-rulez derives the `pi` entry, the
# `pi-package` keyword and the `files` allowlist in package.json from the skills
# on disk and rewrites the whole file (sorted keys, expanded arrays), keeping
# the authored fields (scripts, devDependencies). Edit those, not the derived ones.
[plugin.pi]
skills_dir = "skills"
package_json = "merge"

[marketplace]
name = "{{ repo_name }}"
