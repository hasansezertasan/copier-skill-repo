# Project overrides live below the fence, where cobo preserves them.
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true

[*.{json,jsonc,md,toml}]
indent_size = 2

# cobo's sealed blocks carry upstream trailing whitespace; trimming it breaks the seal.
[{.gitignore,.gitattributes,.editorconfig}]
trim_trailing_whitespace = false

# `.lock` falls outside the TOML glob above.
[cobo.lock]
indent_size = 2

[*.{png,jpg,gif,ico,woff,woff2,ttf,eot,svg,pdf}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
