root = true

[*]
end_of_line = lf
charset = utf-8

[{*.js,*.json}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.js]
block_comment_start = /**
block_comment = *
block_comment_end = */
